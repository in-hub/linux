/dts-v1/;

#include "imx8qxp-colibri-inhub.dtsi"

/ {
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;

		led_green_status: green-status {
			label = "green:status";
			gpios = <&lsio_gpio1 24 0x0>;
			default-state = "off";
		};

		led_red_status: red-status {
			label = "red:status";
			gpios = <&lsio_gpio1 23 0x0>;
			default-state = "off";
		};

		led_green_activity: green-activity {
			label = "green:activity";
			gpios = <&lsio_gpio2 0 0x0>;
			default-state = "off";
		};

		led_red_activity: red-activity {
			label = "red:activity";
			gpios = <&lsio_gpio0 29 0x0>;
			default-state = "off";
		};

		led_green_heartbeat: green-heartbeat {
			label = "green:heartbeat";
			gpios = <&lsio_gpio0 30 0x0>;
			default-state = "off";
			linux,default-trigger = "timer";
		};

		led_red_disk: red-disk {
			label = "red:disk";
			gpios = <&lsio_gpio3 3 0x0>;
			default-state = "off";
			linux,default-trigger = "mmc0";
		};
	};
};

&iomuxc {
	/delete-node/ i2c1grp;

	pinctrl_leds: ledsgrp {
		fsl,pins = <
			IMX8QXP_UART2_RX_LSIO_GPIO1_IO24			0x20 /* SODIMM 19 / LED_GREEN_STATUS */
			IMX8QXP_UART2_TX_LSIO_GPIO1_IO23			0x20 /* SODIMM 21 / LED_RED_STATUS */
			IMX8QXP_MIPI_DSI1_GPIO0_01_LSIO_GPIO2_IO00	0x20 /* SODIMM 23 / LED_GREEN_ACTIVITY */
			IMX8QXP_SAI1_RXD_LSIO_GPIO0_IO29			0x20 /* SODIMM 25 / LED_RED_ACTIVITY */
			IMX8QXP_SAI1_RXC_LSIO_GPIO0_IO30			0x20 /* SODIMM 27 / LED_GREEN_HEARTBEAT */
			IMX8QXP_CSI_RESET_LSIO_GPIO3_IO03			0x20 /* SODIMM 29 / LED_RED_DISK */

		>;
	};

	pinctrl_reset: resetgrp {
		fsl,pins = <
			IMX8QXP_USDHC1_CD_B_LSIO_GPIO4_IO22			0x06000040 /* SODIMM 31 / ~RESET */
		>;
	};

	pinctrl_enet2: enet2grp {
		fsl,pins = <
			IMX8QXP_ESAI0_SCKR_CONN_ENET1_RGMII_TX_CTL	0x06000020 /* SODIMM 60 / TXEN */
			IMX8QXP_SPDIF0_TX_CONN_ENET1_RGMII_RX_CTL	0x06000020 /* SODIMM 50 / RXDV */
			IMX8QXP_SPDIF0_RX_CONN_ENET1_RGMII_RXD0		0x06000020 /* SODIMM 74 / RXD0 */
			IMX8QXP_ESAI0_TX3_RX2_CONN_ENET1_RGMII_RXD1	0x06000020 /* SODIMM 46 / RXD1 */
			IMX8QXP_ESAI0_TX4_RX1_CONN_ENET1_RGMII_TXD0	0x06000020 /* SODIMM 62 / TXD0 */
			IMX8QXP_ESAI0_TX5_RX0_CONN_ENET1_RGMII_TXD1	0x06000020 /* SODIMM 48 / TXD1 */
			IMX8QXP_ESAI0_TX2_RX3_CONN_ENET1_RMII_RX_ER	0x06000020 /* SODIMM 80 / RXER */
			IMX8QXP_ESAI0_FSR_CONN_ENET1_RCLK50M_OUT	0x06000061 /* SODIMM 76 / CLK */
			IMX8QXP_USDHC1_WP_LSIO_GPIO4_IO21			0x00000060 /* SODIMM 76 / reseve unused USDHC1_WP */
		>;
	};
};

&enet0_lpcg {
	clocks = <&clk IMX_SC_R_ENET_0 IMX_SC_PM_CLK_PER>,
		<&clk IMX_SC_R_ENET_0 IMX_SC_PM_CLK_PER>,
		<&conn_axi_clk>,
		<&clk IMX_SC_R_ENET_0 IMX_SC_C_DISABLE_50>,
		<&conn_ipg_clk>,
		<&conn_ipg_clk>;
};

&enet1_lpcg {
	clocks = <&clk IMX_SC_R_ENET_1 IMX_SC_PM_CLK_PER>,
		<&clk IMX_SC_R_ENET_1 IMX_SC_PM_CLK_PER>,
		<&conn_axi_clk>,
		<&clk IMX_SC_R_ENET_1 IMX_SC_C_DISABLE_50>,
		<&conn_ipg_clk>,
		<&conn_ipg_clk>;
};

&fec1 {
	status = "okay";

	mdio {
		ethphy1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			max-speed = <100>;
			reg = <1>;
		};
	};
};

&fec2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet2 &pinctrl_reset>;
	phy-mode = "rmii";
	phy-handle = <&ethphy1>;
	status = "okay";
	phy-reset-gpios = <&lsio_gpio4 22 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <10>;

};

&i2c1 {
	status = "disabled";
	/delete-property/ pinctrl-0;
};

&lsio_gpio0 {
	gpio-line-names = "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
