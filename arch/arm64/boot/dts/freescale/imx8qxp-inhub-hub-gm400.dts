&lpuart0 {
	pinctrl-0 = <&pinctrl_backplanebus>;
	linux,rs485-enabled-at-boot-time;
	uart-has-rtscts;
	status = "okay";
};

&lpuart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rs485>;
	linux,rs485-enabled-at-boot-time;
	uart-has-rtscts;
	status = "okay";
};
