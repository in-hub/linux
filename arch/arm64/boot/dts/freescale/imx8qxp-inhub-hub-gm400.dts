			  "IO3_DOUT",
			  "IO4_FLT",
			  "IO4_DIN",
			  "IO2_DIEN",
			  "IO2_ACUREN",
			  "IO3_FLT",
			  "IO3_DIN";
};

&lsio_gpio4 {
	gpio-line-names = "",
			  "",
			  "",
			  "USBH_VBUS",
			  "IO4_DIEN",
			  "",
			  "",
