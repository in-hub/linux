			  "LED_GREEN_STATUS",
			  "",
			  "",
			  "",
			  "BP_SUPPLY_ENABLE",
			  "IO4_ACUREN",
			  "IO4_AFLT",
			  "IO3_DIEN";
};

&lsio_gpio2 {
	gpio-line-names = "LED_GREEN_ACTIVITY";
};

&lsio_gpio3 {
	gpio-line-names = "IO2_DIN",
			  "",
			  "",
			  "LED_RED_DISK",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "RS485_SUPPLY_STATUS",
			  "RS485_SUPPLY_ENABLE",
			  "",
