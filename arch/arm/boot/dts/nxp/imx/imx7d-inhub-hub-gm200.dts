/dts-v1/;
#include "imx7d-colibri-emmc.dtsi"

/delete-node/ &sai1;
/delete-node/ &sai2;
/delete-node/ &sai3;
/delete-node/ &lcdif;
/delete-node/ &pwm1;
/delete-node/ &pwm2;
/delete-node/ &pwm3;
/delete-node/ &pwm4;
/delete-node/ &usdhc1;
/delete-node/ &usdhc2;
/delete-node/ &csi;
/delete-node/ &mipi_csi;

/ {
	model = "in.hub HUB-GM200";
	compatible = "inhub,hub-gm200", "fsl,imx7d";

	/delete-node/ csi-mux;

	aliases {
		/delete-property/ mmc1;
		/delete-property/ mmc2;
		mmc0 = &usdhc3;
	};

	reg_usb_otg1_vbus: regulator-usb-otg1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_otg1_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	reg_adio: regulator-adio {
		compatible = "regulator-fixed";
		regulator-name = "analog-digital-io";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_io1 &pinctrl_gpio_io2 &pinctrl_gpio_io3 &pinctrl_gpio_io4 &pinctrl_gpio_io5 &pinctrl_gpio_io6>;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds &pinctrl_leds_lpsr>;

		led_green_status: green-status {
			label = "green:status";
			gpios = <&gpio1 3 0x0>;
			default-state = "off";
		};

		led_red_status: red-status {
			label = "red:status";
			gpios = <&gpio6 17 0x0>;
			default-state = "off";
		};

		led_green_activity: green-activity {
			label = "green:activity";
			gpios = <&gpio1 9 0x0>;
			default-state = "off";
		};

		led_red_activity: red-activity {
			label = "red:activity";
			gpios = <&gpio1 10 0x0>;
			default-state = "off";
		};

		led_green_heartbeat: green-heartbeat {
			label = "green:heartbeat";
			gpios = <&gpio6 21 0x0>;
			linux,default-trigger = "timer";
		};

		led_red_disk: red-disk {
			label = "red:disk";
			gpios = <&gpio6 22 0x0>;
			default-state = "off";
			linux,default-trigger = "mmc0";
		};
	};

	/delete-node/ backlight;
	/delete-node/ gpio-keys;
	/delete-node/ panel-dpi;
	/delete-node/ sound;
	/delete-node/ regulator-module-3v3-avdd;
};

&adc1 {
	status = "okay";
};

&fec1 {
	status = "okay";
};

&fec2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet2>;
	assigned-clocks = <&clks IMX7D_ENET2_TIME_ROOT_SRC>,
			  <&clks IMX7D_ENET2_TIME_ROOT_CLK>;
	assigned-clock-parents = <&clks IMX7D_PLL_ENET_MAIN_100M_CLK>;
	assigned-clock-rates = <0>, <100000000>;
	phy-mode = "mii";
	phy-handle = <&ethphy1>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy1: ethernet-phy@0 {
			reg = <0>;
			reset-gpios = <&gpio4 4 GPIO_ACTIVE_LOW>;
			reset-assert-us = <2000>;
			reset-deassert-us = <2000>;
		};
	};
};

&gpio1 {
	gpio-line-names =
		"RS485_SUPPLY_STATUS",
		"RS485_SUPPLY_ENABLE",
		"",
		"LED_GREEN_STATUS",
		"",
		"",
		"USB2_OC",
		"USB2_PWR",
		"",
		"LED_GREEN_ACTIVITY",
		"LED_RED_ACTIVITY";
};

&gpio2 {
	gpio-line-names = "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "IO4_DIN",
			  "IO4_FLT",
			  "",
			  "IO3_DIN",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "IO2_ACUREN";
};

&gpio3 {
	gpio-line-names = "IO5_DIN",
			  "IO6_FLT",
			  "IO1_DIEN",
			  "IO4_DOUT",
			  "",
			  "IO3_FLT",
			  "IO1_DOUT",
			  "IO5_DOUT",
			  "IO5_DIEN",
			  "IO2_AFLT",
			  "IO1_DOEN",
			  "IO4_DIEN",
			  "IO6_DIN",
			  "IO5_DOEN",
			  "IO6_DIEN",
			  "IO1_ACUREN",
			  "IO6_DOUT",
			  "IO6_DOEN",
			  "IO5_FLT",
			  "IO1_DIN",
			  "IO1_FLT",
			  "",
			  "",
			  "IO3_DIEN",
			  "IO3_DOUT",
			  "IO3_DOEN",
			  "IO3_ACUREN",
			  "IO4_DOEN",
			  "IO4_ACUREN";
};

&gpio4 {
	gpio-line-names = "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "IO1_AFLT",
			  "",
			  "IO2_FLT",
			  "IO2_DIN",
			  "",
			  "BP_MODULE_DETECTION";
};

&gpio5 {
	gpio-line-names = "",
			  "",
			  "",
			  "CAN_SILENT",
			  "BP_SUPPLY_STATUS",
			  "BP_SUPPLY_ENABLE",
			  "CAN_SUPPLY_ENABLE",
			  "CAN_SUPPLY_STATUS",
			  "",
			  "",
			  "",
			  "IO2_DIEN",
			  "IO4_AFLT",
			  "IO3_AFLT",
			  "",
			  "",
			  "IO2_DOUT",
			  "IO2_DOEN";
};

&gpio6 {
	gpio-line-names = "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "",
			  "LED_RED_STATUS",
			  "",
			  "",
			  "",
			  "LED_GREEN_HEARTBEAT",
			  "LED_RED_DISK";
};

&i2c1 {
	/delete-node/ sgtl5000@a;
	/delete-node/ touchscreen@2c;
};

&iomuxc {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;

	/delete-node/ gpio1grp;
	/delete-node/ gpio2grp;
	/delete-node/ gpio3grp;
	/delete-node/ gpio4grp;
	/delete-node/ lcdifdatgrp;
	/delete-node/ lcdifdat24grp;
	/delete-node/ lcdifctrlgrp;
	/delete-node/ pwm1grp;
	/delete-node/ pwm2grp;
	/delete-node/ pwm3grp;
	/delete-node/ pwm4grp;
	/delete-node/ sai1grp;
	/delete-node/ sai1mclkgrp;
	/delete-node/ usdhc1grp;
	/delete-node/ usdhc1-100mhzgrp;
	/delete-node/ usdhc1-200mhzgrp;
	/delete-node/ usdhc1-slpgrp;

	pinctrl_leds: ledsgrp {
		fsl,pins = <
			MX7D_PAD_LPSR_GPIO1_IO03__GPIO1_IO3	0x14 /* SODIMM 22 / LED1G */
			MX7D_PAD_SAI1_RX_BCLK__GPIO6_IO17	0x14 /* SODIMM 24 / LED1R */
			MX7D_PAD_GPIO1_IO09__GPIO1_IO9		0x14 /* SODIMM 28 / LED2G */
			MX7D_PAD_GPIO1_IO10__GPIO1_IO10		0x14 /* SODIMM 30 / LED2R */
			MX7D_PAD_SAI2_RX_DATA__GPIO6_IO21	0x14 /* SODIMM 32 / LED3G */
			MX7D_PAD_SAI2_TX_DATA__GPIO6_IO22   0x14 /* SODIMM 34 / LED3R */
		>;
	};

	pinctrl_backplanebus: bpbgrp {
		fsl,pins = <
			MX7D_PAD_SAI1_TX_BCLK__UART5_DTE_RX		0x79 /* SODIMM 157 / RXBP */
			MX7D_PAD_SAI1_RX_DATA__UART5_DTE_TX		0x79 /* SODIMM 169 / TXBP */
			MX7D_PAD_SAI1_TX_SYNC__UART5_DTE_RTS	0x79 /* SODIMM 163 / RTS */
			MX7D_PAD_SAI1_TX_DATA__UART5_DTE_CTS	0x79 /* SODIMM 81 / CTS */
			MX7D_PAD_SD1_DATA0__GPIO5_IO5			0x14 /* SODIMM 192 / BP_SUPPLY_ENABLE */
			MX7D_PAD_SD1_CMD__GPIO5_IO4				0x34 /* SODIMM 190 / BP_SUPPLY_STATUS */
			MX7D_PAD_ECSPI1_SCLK__GPIO4_IO16		0x14 /* SODIMM 101 / BP_MODULE_DETECTION */
		>;
	};

	pinctrl_rs485: rs485grp {
		fsl,pins = <
			MX7D_PAD_ECSPI2_MOSI__UART7_DTE_RX		0x79 /* SODIMM 59 - RXD7 */
			MX7D_PAD_ECSPI2_SCLK__UART7_DTE_TX		0x79 /* SODIMM 67 - TDX7 */
			MX7D_PAD_ECSPI2_SS0__UART7_DTE_RTS		0x79 /* SODIMM 53 - RTS7 */
			MX7D_PAD_SD1_DATA3__UART7_DTE_CTS		0x79 /* SODIMM 65 - CTS7 */
		>;
	};

	pinctrl_gpio_io1: io1grp {
		fsl,pins = <
			MX7D_PAD_LCD_DATA15__GPIO3_IO20		0x34 /* SODIMM 64 - FLT1 */
			MX7D_PAD_LCD_DATA14__GPIO3_IO19		0x34 /* SODIMM 66 - DIN1 / DOI_LVL */
			MX7D_PAD_LCD_HSYNC__GPIO3_IO2		0x14 /* SODIMM 68 - PDEN1 / DI_EN */
			MX7D_PAD_LCD_DATA01__GPIO3_IO6		0x14 /* SODIMM 70 - DOUT1 / IN */
			MX7D_PAD_LCD_DATA05__GPIO3_IO10		0x14 /* SODIMM 72 - DOEN1 / PP */
			MX7D_PAD_LCD_DATA10__GPIO3_IO15		0x14 /* SODIMM 74 - ACUREN1 / ACUREN */
			MX7D_PAD_I2C2_SDA__GPIO4_IO11		0x34 /* SODIMM 86 - AFLT1 */
		>;
	};

	pinctrl_gpio_io2: io2grp {
		fsl,pins = <
			MX7D_PAD_I2C3_SDA__GPIO4_IO13		0x34 /* SODIMM 94  - FLT2 */
			MX7D_PAD_I2C4_SCL__GPIO4_IO14		0x34 /* SODIMM 96  - DIN2 / DOI_LVL */
			MX7D_PAD_SD2_RESET_B__GPIO5_IO11	0x14 /* SODIMM 98  - PDEN2 / DI_EN */
			MX7D_PAD_SD2_DATA2__GPIO5_IO16		0x14 /* SODIMM 100 - DOUT2 / IN */
			MX7D_PAD_SD2_DATA3__GPIO5_IO17		0x14 /* SODIMM 102 - DOEN2 / PP */
			MX7D_PAD_EPDC_GDSP__GPIO2_IO27		0x14 /* SODIMM 104 - ACUREN2 / ACUREN */
			MX7D_PAD_LCD_DATA04__GPIO3_IO9		0x34 /* SODIMM 78 - AFLT2 */
		>;
	};

	pinctrl_gpio_io3: io3grp {
		fsl,pins = <
			MX7D_PAD_LCD_DATA00__GPIO3_IO5		0x34 /* SODIMM 76 - FLT3 */
			MX7D_PAD_EPDC_DATA14__GPIO2_IO14	0x34 /* SODIMM 126 - DIN3 / DOI_LVL */
			MX7D_PAD_LCD_DATA18__GPIO3_IO23		0x14 /* SODIMM 136 - PDEN3 / DI_EN */
			MX7D_PAD_LCD_DATA19__GPIO3_IO24		0x14 /* SODIMM 138 - DOUT3 / IN */
			MX7D_PAD_LCD_DATA20__GPIO3_IO25		0x14 /* SODIMM 140 - DOEN3 / PP */
			MX7D_PAD_LCD_DATA21__GPIO3_IO26		0x14 /* SODIMM 142 - ACUREN3 / ACUREN */
			MX7D_PAD_SD2_CMD__GPIO5_IO13		0x34 /* SODIMM 186 - AFLT3 */
		>;
	};

	pinctrl_gpio_io4: io4grp {
		fsl,pins = <
			MX7D_PAD_EPDC_DATA12__GPIO2_IO12	0x34 /* SODIMM 150 - FLT4 */
			MX7D_PAD_EPDC_DATA11__GPIO2_IO11	0x34 /* SODIMM 152 - DIN4 / DOI_LVL */
			MX7D_PAD_LCD_DATA06__GPIO3_IO11		0x14 /* SODIMM 80  - PDEN4 / DI_EN */
			MX7D_PAD_LCD_VSYNC__GPIO3_IO3		0x14 /* SODIMM 82  - DOUT4 / IN */
			MX7D_PAD_LCD_DATA22__GPIO3_IO27		0x14 /* SODIMM 144 - DOEN4 / PP */
			MX7D_PAD_LCD_DATA23__GPIO3_IO28		0x14 /* SODIMM 146 - ACUREN4 / ACUREN */
			MX7D_PAD_SD2_CLK__GPIO5_IO12		0x34 /* SODIMM 184 - AFLT4 */
		>;
	};

	pinctrl_gpio_io5: io5grp {
		fsl,pins = <
			MX7D_PAD_LCD_DATA13__GPIO3_IO18		0x34 /* SODIMM 54 - FLT5 */
			MX7D_PAD_LCD_CLK__GPIO3_IO0			0x34 /* SODIMM 56 - DIN5 / DOI_LVL */
			MX7D_PAD_LCD_DATA03__GPIO3_IO8		0x14 /* SODIMM 58 - PDEN5 / DI_EN */
			MX7D_PAD_LCD_DATA02__GPIO3_IO7		0x14 /* SODIMM 60 - DOUT5 / IN */
			MX7D_PAD_LCD_DATA08__GPIO3_IO13		0x14 /* SODIMM 62 - DOEN5 / PP */
		>;
	};

	pinctrl_gpio_io6: io6grp {
		fsl,pins = <
			MX7D_PAD_LCD_ENABLE__GPIO3_IO1		0x34 /* SODIMM 54 - FLT6 */
			MX7D_PAD_LCD_DATA07__GPIO3_IO12		0x34 /* SODIMM 46 - DIN6 / DOI_LVL */
			MX7D_PAD_LCD_DATA09__GPIO3_IO14		0x14 /* SODIMM 48 - PDEN6 / DI_EN */
			MX7D_PAD_LCD_DATA11__GPIO3_IO16		0x14 /* SODIMM 50 - DOUT6 / IN */
			MX7D_PAD_LCD_DATA12__GPIO3_IO17		0x14 /* SODIMM 52 - DOEN6 / PP */
		>;
	};

	pinctrl_enet2: enet2grp {
		fsl,pins = <
			MX7D_PAD_EPDC_PWR_STAT__ENET2_COL			0x11
			MX7D_PAD_EPDC_PWR_COM__ENET2_CRS			0x11
			MX7D_PAD_GPIO1_IO15__ENET2_MDC				0x37
			MX7D_PAD_GPIO1_IO14__ENET2_MDIO				0x37
			MX7D_PAD_EPDC_SDCLK__ENET2_RGMII_RD0		0x11
			MX7D_PAD_EPDC_SDLE__ENET2_RGMII_RD1			0x11
			MX7D_PAD_EPDC_SDOE__ENET2_RGMII_RD2			0x11
			MX7D_PAD_EPDC_SDSHR__ENET2_RGMII_RD3		0x11
			MX7D_PAD_EPDC_BDR1__ENET2_RX_CLK			0x11
			MX7D_PAD_EPDC_SDCE0__ENET2_RGMII_RX_CTL		0x11
			MX7D_PAD_EPDC_SDCE1__ENET2_RX_ER			0x11
			MX7D_PAD_EPDC_SDCE2__ENET2_RGMII_TD0		0x11
			MX7D_PAD_EPDC_SDCE3__ENET2_RGMII_TD1		0x11
			MX7D_PAD_EPDC_GDCLK__ENET2_RGMII_TD2		0x11
			MX7D_PAD_EPDC_GDOE__ENET2_RGMII_TD3			0x11
			MX7D_PAD_EPDC_BDR0__ENET2_TX_CLK			0x11
			MX7D_PAD_EPDC_GDRL__ENET2_RGMII_TX_CTL		0x11
			MX7D_PAD_UART3_RX_DATA__GPIO4_IO4			0x14
		>;
	};

	pinctrl_flexcan1: flexcan1grp {
		fsl,pins = <
			MX7D_PAD_ENET1_RGMII_RD2__FLEXCAN1_RX	0x59	/* SODIMM 63 - CAN/RX */
			MX7D_PAD_ENET1_RGMII_RD3__FLEXCAN1_TX	0x59	/* SODIMM 55 - CAN/TX */
			MX7D_PAD_SD1_CLK__GPIO5_IO3				0x14	/* SODIMM 47 - CAN_SILENT */
			MX7D_PAD_SD1_DATA1__GPIO5_IO6			0x14	/* SODIMM 49 - CAN_SUPPLY_ENABLE */
			MX7D_PAD_SD1_DATA2__GPIO5_IO7			0x34	/* SODIMM 51 - CAN_SUPPLY_STATUS */
		>;
	};
};

&iomuxc_lpsr {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;

	/delete-node/ gpiolpsrgrp;
	/delete-node/ gpiokeysgrp;

	pinctrl_leds_lpsr: ledslpsrgrp {
		fsl,pins = <
			MX7D_PAD_LPSR_GPIO1_IO03__GPIO1_IO3	0x14 /* SODIMM 22 / LED1G */
		>;
	};

	pinctrl_rs485_ctl: rs485ctlgrp {
		fsl,pins = <
			MX7D_PAD_LPSR_GPIO1_IO01__GPIO1_IO1		0x14 /* SODIMM 45 / RS485_SUPPLY_ENABLE */
			MX7D_PAD_LPSR_GPIO1_IO00__GPIO1_IO0		0x34 /* SODIMM 43 / RS485_SUPPLY_STATUS */
		>;
	};

	pinctrl_usb_otg2: otg2grp {
		fsl,pins = <
			MX7D_PAD_LPSR_GPIO1_IO06__USB_OTG2_OC	0x7d	/* SODIMM 37 - USB OTG2/OC */
			MX7D_PAD_LPSR_GPIO1_IO07__GPIO1_IO7		0x14	/* SODIMM 29 - USB OTG2/PWR */
		>;
	};
};

&flexcan1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	status = "okay";
};

&reg_usbh_vbus {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_otg2>;
	gpio = <&gpio1 7 GPIO_ACTIVE_LOW>;
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&pinctrl_uart1>;
	/delete-node/ uart-has-rtscts;
};

&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_backplanebus>;
	linux,rs485-enabled-at-boot-time;
	uart-has-rtscts;
	fsl,dte-mode;
	status = "okay";
};

&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rs485 &pinctrl_rs485_ctl>;
	linux,rs485-enabled-at-boot-time;
	uart-has-rtscts;
	fsl,dte-mode;
	status = "okay";
};

&usbotg1 {
	disable-over-current;
	extcon = <&extcon_usbc_det>;
	vbus-supply = <&reg_usb_otg1_vbus>;
	status = "okay";
};

&usbotg2 {
	status = "okay";
};
